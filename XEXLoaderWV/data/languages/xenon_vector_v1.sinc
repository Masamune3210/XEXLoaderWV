xenonB: "xv100" is vrBR=4 & BITS_0_1=3 { export xv100; }
xenonB: "xv101" is vrBR=5 & BITS_0_1=3 { export xv101; }
xenonB: "xv102" is vrBR=6 & BITS_0_1=3 { export xv102; }
xenonB: "xv103" is vrBR=7 & BITS_0_1=3 { export xv103; }
xenonB: "xv104" is vrBR=8 & BITS_0_1=3 { export xv104; }
xenonB: "xv105" is vrBR=9 & BITS_0_1=3 { export xv105; }
xenonB: "xv106" is vrBR=10 & BITS_0_1=3 { export xv106; }
xenonB: "xv107" is vrBR=11 & BITS_0_1=3 { export xv107; }
xenonB: "xv108" is vrBR=12 & BITS_0_1=3 { export xv108; }
xenonB: "xv109" is vrBR=13 & BITS_0_1=3 { export xv109; }
xenonB: "xv110" is vrBR=14 & BITS_0_1=3 { export xv110; }
xenonB: "xv111" is vrBR=15 & BITS_0_1=3 { export xv111; }
xenonB: "xv112" is vrBR=16 & BITS_0_1=3 { export xv112; }
xenonB: "xv113" is vrBR=17 & BITS_0_1=3 { export xv113; }
xenonB: "xv114" is vrBR=18 & BITS_0_1=3 { export xv114; }
xenonB: "xv115" is vrBR=19 & BITS_0_1=3 { export xv115; }
xenonB: "xv116" is vrBR=20 & BITS_0_1=3 { export xv116; }
xenonB: "xv117" is vrBR=21 & BITS_0_1=3 { export xv117; }
xenonB: "xv118" is vrBR=22 & BITS_0_1=3 { export xv118; }
xenonB: "xv119" is vrBR=23 & BITS_0_1=3 { export xv119; }
xenonB: "xv120" is vrBR=24 & BITS_0_1=3 { export xv120; }
xenonB: "xv121" is vrBR=25 & BITS_0_1=3 { export xv121; }
xenonB: "xv122" is vrBR=26 & BITS_0_1=3 { export xv122; }
xenonB: "xv123" is vrBR=27 & BITS_0_1=3 { export xv123; }
xenonB: "xv124" is vrBR=28 & BITS_0_1=3 { export xv124; }
xenonB: "xv125" is vrBR=29 & BITS_0_1=3 { export xv125; }
xenonB: "xv126" is vrBR=30 & BITS_0_1=3 { export xv126; }
xenonB: "xv127" is vrBR=31 & BITS_0_1=3 { export xv127; }

# Opcode 4, VX128_1: [OP:6][VD:5][RA:5][RB:5][OPC:7][VDh:2][11].
# Seven-bit OPC is 12 for lvx128. Since stock token XOP_3_10 also
# covers high register bit 1, we have two constructor patterns.
:lvx128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=24 & BITS_0_1=3
{
    build RA_OR_ZERO;
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xfffffffffffffff0;
    xenonD = *[ram]:16 ea;
}
:lvx128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=25 & BITS_0_1=3
{
    build RA_OR_ZERO;
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xfffffffffffffff0;
    xenonD = *[ram]:16 ea;
}

# Xbox extension X-form loads use the existing 32 AltiVec/VSX registers.
# Xenia's opcode table: lvlx=0x7C00040E, lvrx=0x7C00044E.
# The semantics below are 128-bit left/right byte-window loads. An
# aligned lvrx address produces zero without touching memory.
:lvlx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=519 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    shift:$(REGISTER_SIZE) = (addr & 15) * 8;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    data:16 = *[ram]:16 aligned;
    vrD = data << shift;
}
:lvrx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=551 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    off:$(REGISTER_SIZE) = addr & 15;
    if (off == 0) goto <aligned_case>;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    data:16 = *[ram]:16 aligned;
    shift:$(REGISTER_SIZE) = (16 - off) * 8;
    vrD = data >> shift;
    goto <done>;
<aligned_case>
    vrD = zext(0:8);
<done>
}

# Opcode 6, VX128_3: OPC=127 (bits 21..27 in Xenia notation);
# bottom two bits extend VB and the next two bits extend VD.
# UIMM=(16,20), with D3D unpack format in UIMM>>2.
# The opcode is real and changes a vector register. Until supported
# numeric unpack types have verified p-code, use an explicit userop
# rather than fabricating byte-level behavior or treating it as NOP.
:vupkd3d128 xenonD,xenonB,UIMM is OP=6 & xenonD & xenonB & UIMM & XOP_3_10=254
{
    unpacked:16 = xenonVupkd3d128(xenonB, UIMM:4);
    xenonD = unpacked;
}
:vupkd3d128 xenonD,xenonB,UIMM is OP=6 & xenonD & xenonB & UIMM & XOP_3_10=255
{
    unpacked:16 = xenonVupkd3d128(xenonB, UIMM:4);
    xenonD = unpacked;
}
