# VX128_1 indexed store: selector bits 3..10 are 0x38 / 0x39
# depending on the destination's extended high-register bit.
# Kept as a real 16-byte memory store, not an opaque userop.
:stvx128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=56 & BITS_0_1=3
{
    build RA_OR_ZERO;
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xfffffffffffffff0;
    *[ram]:16 ea = xenonD;
}
:stvx128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=57 & BITS_0_1=3
{
