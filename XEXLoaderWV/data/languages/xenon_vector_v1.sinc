# dcbz128 differs from generic dcbz by RT=1 (BITS_21_25). It clears
# the entire 128-byte-aligned cache line, per Xenia's memory emitter.
# Generic dcbz is restricted to RT=0 in Xenon's generated ppc_isa.sinc.
:dcbz128 RA_OR_ZERO,B is OP=31 & BITS_21_25=1 & RA_OR_ZERO & B & XOP_1_10=1014
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xffffffffffffff80;
    zeroVec:16 = zext(0:8);
    *[ram]:16 addr = zeroVec;
    target1:$(REGISTER_SIZE) = addr + 16;
    *[ram]:16 target1 = zeroVec;
    target2:$(REGISTER_SIZE) = addr + 32;
    *[ram]:16 target2 = zeroVec;
    target3:$(REGISTER_SIZE) = addr + 48;
    *[ram]:16 target3 = zeroVec;
    target4:$(REGISTER_SIZE) = addr + 64;
    *[ram]:16 target4 = zeroVec;
    target5:$(REGISTER_SIZE) = addr + 80;
    *[ram]:16 target5 = zeroVec;
    target6:$(REGISTER_SIZE) = addr + 96;
    *[ram]:16 target6 = zeroVec;
    target7:$(REGISTER_SIZE) = addr + 112;
    *[ram]:16 target7 = zeroVec;
}
