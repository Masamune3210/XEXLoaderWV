# ---- VMX128 vector permutation-control generators (opaque) ----
# Output depends on EA mod 16. The custom userop explicitly records this
# dependency pending proven per-byte shift-mask numerical semantics.



:lvsl128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=0 & BITS_0_1=3
{
    build RA_OR_ZERO;
    ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    off:4 = (ea & 15);
    byteValue0:4 = off;
    octet0:1 = byteValue0(0);
    part0:16 = zext(octet0) << 120;
    byteValue1:4 = off + 1;
    octet1:1 = byteValue1(0);
    part1:16 = zext(octet1) << 112;
    byteValue2:4 = off + 2;
    octet2:1 = byteValue2(0);
    part2:16 = zext(octet2) << 104;
    byteValue3:4 = off + 3;
    octet3:1 = byteValue3(0);
    part3:16 = zext(octet3) << 96;
    byteValue4:4 = off + 4;
    octet4:1 = byteValue4(0);
    part4:16 = zext(octet4) << 88;
    byteValue5:4 = off + 5;
    octet5:1 = byteValue5(0);
    part5:16 = zext(octet5) << 80;
    byteValue6:4 = off + 6;
    octet6:1 = byteValue6(0);
    part6:16 = zext(octet6) << 72;
    byteValue7:4 = off + 7;
    octet7:1 = byteValue7(0);
    part7:16 = zext(octet7) << 64;
    byteValue8:4 = off + 8;
    octet8:1 = byteValue8(0);
    part8:16 = zext(octet8) << 56;
    byteValue9:4 = off + 9;
    octet9:1 = byteValue9(0);
    part9:16 = zext(octet9) << 48;
    byteValue10:4 = off + 10;
    octet10:1 = byteValue10(0);
    part10:16 = zext(octet10) << 40;
    byteValue11:4 = off + 11;
    octet11:1 = byteValue11(0);
    part11:16 = zext(octet11) << 32;
    byteValue12:4 = off + 12;
    octet12:1 = byteValue12(0);
    part12:16 = zext(octet12) << 24;
    byteValue13:4 = off + 13;
    octet13:1 = byteValue13(0);
    part13:16 = zext(octet13) << 16;
    byteValue14:4 = off + 14;
    octet14:1 = byteValue14(0);
    part14:16 = zext(octet14) << 8;
    byteValue15:4 = off + 15;
    octet15:1 = byteValue15(0);
    part15:16 = zext(octet15);
    xenonD = part0 | part1 | part2 | part3 | part4 | part5 | part6 | part7 | part8 | part9 | part10 | part11 | part12 | part13 | part14 | part15;
}

