# ---- Opcode-31 Xbox vector X-form extensions ----
# The Rc-bit-requiring samples are left unsupported deliberately, as the
# actual Xenon hardware legality of Rc=1 needs independent verification.
# Two opcode-31 forms collide with Ghidra's generic A2 stvepx instructions,
# removed ONLY from the variant-local generated ppc_isa.sinc.

:stvlx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=647 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    shift:$(REGISTER_SIZE) = (addr & 15) * 8;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    zeroVec:16 = zext(0:8);
    mask:16 = ~zeroVec >> shift;
    oldValue:16 = *[ram]:16 aligned;
    newValue:16 = vrD >> shift;
    *[ram]:16 aligned = (oldValue & ~mask) | (newValue & mask);
}

:stvrx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=679 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    off:$(REGISTER_SIZE) = addr & 15;
    if (off == 0) goto <done>;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    shift:$(REGISTER_SIZE) = (16 - off) * 8;
    zeroVec:16 = zext(0:8);
    mask:16 = ~(~zeroVec >> shift);
    oldValue:16 = *[ram]:16 aligned;
    newValue:16 = vrD << shift;
    *[ram]:16 aligned = (oldValue & ~mask) | (newValue & mask);
<done>
}

:lvlxl vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=775 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    shift:$(REGISTER_SIZE) = (addr & 15) * 8;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    data:16 = *[ram]:16 aligned;
    vrD = data << shift;
}

:lvrxl vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=807 & Rc=0
