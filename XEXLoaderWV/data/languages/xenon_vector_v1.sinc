    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xfffffffffffffff0;
    *[ram]:16 ea = xenonD;
}

# VX128_P permute-word-immediate: bits 10:9=01 and bits 5:4=01,
# low five immediate bits A_BITS, upper three in bits 6..8.
# Preserve source, dest, and both parts of the immediate in p-code.
# Numeric lane permute semantics remain explicit/opaque pending a
# verified word-lane implementation.
:vpermwi128 xenonD,xenonB,A_BITS is OP=6 & xenonD & xenonB & A_BITS & BITS_4_5=1 & BITS_6_10=8
{
    out:16 = xenonVpermwi128(xenonB, A_BITS:4, 0:4);
    xenonD = out;
}
:vpermwi128 xenonD,xenonB,A_BITS is OP=6 & xenonD & xenonB & A_BITS & BITS_4_5=1 & BITS_6_10=9
{
