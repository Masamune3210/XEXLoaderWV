    bFirst:4 = xenonB(4);
    aSecond:4 = xenonA(0);
    bSecond:4 = xenonB(0);
    first:16 = zext(aFirst) << 96;
    second:16 = zext(bFirst) << 64;
    third:16 = zext(aSecond) << 32;
    fourth:16 = zext(bSecond);
    xenonD = first | second | third | fourth;
}
:vmrglw128 xenonD,xenonA,xenonB is OP=6 & xenonD & xenonA & xenonB & BITS_6_10=29 & BITS_4_5=2
