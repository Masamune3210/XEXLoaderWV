# Xbox 360 Xenon vector extension for the existing Ghidra PPC64/AltiVec SLEIGH.
# Stock code and registers remain intact. This add-on adds precisely the
# verified VMX128 families without replacing the stock PPC language.
#
# IMPORTANT: this is a *separate language variant*, not an injected opcode
# overlay on an existing Program. Build the .sla before selecting the variant.
#
# Ghidra's VSX vs32..vs63 are the low Xenon vector registers 0..31.
# Model the remaining 96 128-bit registers separately and NEVER alias them
# onto existing 32-register AltiVec state.
define register offset=0x4400 size=16 [

    xv32 xv33 xv34 xv35 xv36 xv37 xv38 xv39 xv40 xv41 xv42 xv43 
    xv44 xv45 xv46 xv47 xv48 xv49 xv50 xv51 xv52 xv53 xv54 xv55 
    xv56 xv57 xv58 xv59 xv60 xv61 xv62 xv63 xv64 xv65 xv66 xv67 
    xv68 xv69 xv70 xv71 xv72 xv73 xv74 xv75 xv76 xv77 xv78 xv79 
    xv80 xv81 xv82 xv83 xv84 xv85 xv86 xv87 xv88 xv89 xv90 xv91 
    xv92 xv93 xv94 xv95 xv96 xv97 xv98 xv99 xv100 xv101 xv102 xv103 
    xv104 xv105 xv106 xv107 xv108 xv109 xv110 xv111 xv112 xv113 xv114 xv115 
    xv116 xv117 xv118 xv119 xv120 xv121 xv122 xv123 xv124 xv125 xv126 xv127 
];

# vupkd3d128 implements seven D3D packed types. A CALL_OTHER pcode
# operation preserves the correct destination dependency until a verified
# per-format unpack implementation is available; it is NOT a numeric model.
define pcodeop xenonVupkd3d128;

# Destination uses bits [6:10] and high register bits at [28:29] of
# the 32-bit PPC instruction. In Ghidra token coordinates: vrDR=(21,25),
# AX=(2,2), CX=(3,3). Do not confuse bit order with Xenia MSB numbering.
xenonD: "vs32" is vrDR=0 & AX=0 & CX=0 { export vs32; }
xenonD: "vs33" is vrDR=1 & AX=0 & CX=0 { export vs33; }
xenonD: "vs34" is vrDR=2 & AX=0 & CX=0 { export vs34; }
xenonD: "vs35" is vrDR=3 & AX=0 & CX=0 { export vs35; }
