# Opcode 4, VX128_1: [OP:6][VD:5][RA:5][RB:5][OPC:7][VDh:2][11].
# Seven-bit OPC is 12 for lvx128. Since stock token XOP_3_10 also
# covers high register bit 1, we have two constructor patterns.
:lvx128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=24 & BITS_0_1=3
{
    build RA_OR_ZERO;
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xfffffffffffffff0;
    xenonD = *[ram]:16 ea;
}
:lvx128 xenonD,RA_OR_ZERO,B is OP=4 & xenonD & RA_OR_ZERO & B & XOP_3_10=25 & BITS_0_1=3
{
    build RA_OR_ZERO;
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + B) & 0xfffffffffffffff0;
    xenonD = *[ram]:16 ea;
}

# Xbox extension X-form loads use the existing 32 AltiVec/VSX registers.
# Xenia's opcode table: lvlx=0x7C00040E, lvrx=0x7C00044E.
# The semantics below are 128-bit left/right byte-window loads. An
# aligned lvrx address produces zero without touching memory.
:lvlx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=519 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    shift:$(REGISTER_SIZE) = (addr & 15) * 8;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    data:16 = *[ram]:16 aligned;
    vrD = data << shift;
}
:lvrx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=551 & Rc=0
{
    build RA_OR_ZERO;
    addr:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    off:$(REGISTER_SIZE) = addr & 15;
    if (off == 0) goto <aligned_case>;
    aligned:$(REGISTER_SIZE) = addr & 0xfffffffffffffff0;
    data:16 = *[ram]:16 aligned;
    shift:$(REGISTER_SIZE) = (16 - off) * 8;
    vrD = data >> shift;
    goto <done>;
<aligned_case>
    vrD = zext(0:8);
<done>
}

# Opcode 6, VX128_3: OPC=127 (bits 21..27 in Xenia notation);
# bottom two bits extend VB and the next two bits extend VD.
# A_BITS=(16,20) is the VX128_3 five-bit immediate; D3D format is A_BITS>>2.
# The stock UIMM field spans (0,15) and is NOT the VX128_3 immediate.
# The opcode is real and changes a vector register. Until supported
# numeric unpack types have verified p-code, use an explicit userop
# rather than fabricating byte-level behavior or treating it as NOP.
:vupkd3d128 xenonD,xenonB,A_BITS is OP=6 & xenonD & xenonB & A_BITS & XOP_3_10=254
{
    unpacked:16 = xenonVupkd3d128(xenonB, A_BITS:4);
    xenonD = unpacked;
}
:vupkd3d128 xenonD,xenonB,A_BITS is OP=6 & xenonD & xenonB & A_BITS & XOP_3_10=255
{
    unpacked:16 = xenonVupkd3d128(xenonB, A_BITS:4);
    xenonD = unpacked;
}

# --------------------------------------------------------------------
# Remaining concrete VMX128 instructions observed in the newly imported
# 17559 Xenon-language database. All masks follow Xenia's PPC decoder:
# https://github.com/xenia-project/xenia/blob/master/src/xenia/cpu/ppc/ppc_opcode_lookup_gen.cc
# Raw instruction words from xboxkrnl.exe(6).gzf have been checked.
# --------------------------------------------------------------------

# In format VX128, A occupies seven bits (vrAR plus bits 5 and 10).
# The fixed instruction selector occupies bits 6..9 and bit 4.
# BITS_6_10 includes bit 10, and BITS_4_5 includes bit 5, so the
# four high-A combinations need disjoint SLEIGH pattern alternatives.
define pcodeop xenonVmsum4fp128;
define pcodeop xenonVpermwi128;
define pcodeop xenonVrlimi128;
:vmulfp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=2 & BITS_4_5=1
{
    a0:4 = xenonA(0);
    b0:4 = xenonB(0);
    r0:4 = a0 f* b0;
    a1:4 = xenonA(4);
    b1:4 = xenonB(4);
    r1:4 = a1 f* b1;
    a2:4 = xenonA(8);
    b2:4 = xenonB(8);
    r2:4 = a2 f* b2;
    a3:4 = xenonA(12);
    b3:4 = xenonB(12);
    r3:4 = a3 f* b3;
    wide0:16 = zext(r0);
    wide1:16 = zext(r1) << 32;
    wide2:16 = zext(r2) << 64;
    wide3:16 = zext(r3) << 96;
    xenonD = wide3 | wide2 | wide1 | wide0;
}
:vmulfp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=2 & BITS_4_5=3
{
    a0:4 = xenonA(0);
    b0:4 = xenonB(0);
    r0:4 = a0 f* b0;
    a1:4 = xenonA(4);
    b1:4 = xenonB(4);
    r1:4 = a1 f* b1;
    a2:4 = xenonA(8);
    b2:4 = xenonB(8);
    r2:4 = a2 f* b2;
    a3:4 = xenonA(12);
    b3:4 = xenonB(12);
    r3:4 = a3 f* b3;
    wide0:16 = zext(r0);
    wide1:16 = zext(r1) << 32;
    wide2:16 = zext(r2) << 64;
    wide3:16 = zext(r3) << 96;
    xenonD = wide3 | wide2 | wide1 | wide0;
}
:vmulfp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=18 & BITS_4_5=1
{
    a0:4 = xenonA(0);
    b0:4 = xenonB(0);
    r0:4 = a0 f* b0;
    a1:4 = xenonA(4);
    b1:4 = xenonB(4);
    r1:4 = a1 f* b1;
    a2:4 = xenonA(8);
    b2:4 = xenonB(8);
    r2:4 = a2 f* b2;
    a3:4 = xenonA(12);
    b3:4 = xenonB(12);
    r3:4 = a3 f* b3;
    wide0:16 = zext(r0);
    wide1:16 = zext(r1) << 32;
    wide2:16 = zext(r2) << 64;
    wide3:16 = zext(r3) << 96;
    xenonD = wide3 | wide2 | wide1 | wide0;
}
:vmulfp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=18 & BITS_4_5=3
{
    a0:4 = xenonA(0);
    b0:4 = xenonB(0);
    r0:4 = a0 f* b0;
    a1:4 = xenonA(4);
    b1:4 = xenonB(4);
    r1:4 = a1 f* b1;
    a2:4 = xenonA(8);
    b2:4 = xenonB(8);
    r2:4 = a2 f* b2;
    a3:4 = xenonA(12);
    b3:4 = xenonB(12);
    r3:4 = a3 f* b3;
    wide0:16 = zext(r0);
    wide1:16 = zext(r1) << 32;
    wide2:16 = zext(r2) << 64;
    wide3:16 = zext(r3) << 96;
    xenonD = wide3 | wide2 | wide1 | wide0;
}
:vmsum4fp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=7 & BITS_4_5=1
{
    out:16 = xenonVmsum4fp128(xenonA, xenonB);
    xenonD = out;
}
