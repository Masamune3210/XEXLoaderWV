# bits 5:4=01, 2-bit rotate selector in bits 7:6.
# This writes back a blend of prior VD and rotated VB.
:vrlimi128 xenonD,xenonB,A_BITS is OP=6 & xenonD & xenonB & A_BITS & BITS_4_5=1 & BITS_6_10=28
