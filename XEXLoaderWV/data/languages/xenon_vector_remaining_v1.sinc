# vsldoi128: native; Xenia mask/value fc000010/10000010
:vsldoi128 xenonD,xenonA,xenonB,BITS_6_10 is OP=4 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=1
{
    shift:4 = (BITS_6_10:4 & 15) * 8;
    back:4 = 128 - shift;
    xenonD = (xenonA << shift) | (xenonB >> back);
}

:vsldoi128 xenonD,xenonA,xenonB,BITS_6_10 is OP=4 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=3
{
    shift:4 = (BITS_6_10:4 & 15) * 8;
    back:4 = 128 - shift;
    xenonD = (xenonA << shift) | (xenonB >> back);
}

# Third source of vperm128 is a 3-bit VC selector (VR0..VR7).
# VX128_2 places VC in bits 6..8; bit 10 is VA's high bit.
# Bind actual register dependencies, not merely the encoded VC immediate.
xenonC: "vs32" is BITS_6_10=0 { export vs32; }
xenonC: "vs33" is BITS_6_10=1 { export vs33; }
xenonC: "vs34" is BITS_6_10=2 { export vs34; }
xenonC: "vs35" is BITS_6_10=3 { export vs35; }
xenonC: "vs36" is BITS_6_10=4 { export vs36; }
xenonC: "vs37" is BITS_6_10=5 { export vs37; }
xenonC: "vs38" is BITS_6_10=6 { export vs38; }
xenonC: "vs39" is BITS_6_10=7 { export vs39; }
xenonC: "vs32" is BITS_6_10=16 { export vs32; }
xenonC: "vs33" is BITS_6_10=17 { export vs33; }
xenonC: "vs34" is BITS_6_10=18 { export vs34; }
xenonC: "vs35" is BITS_6_10=19 { export vs35; }
xenonC: "vs36" is BITS_6_10=20 { export vs36; }
xenonC: "vs37" is BITS_6_10=21 { export vs37; }
xenonC: "vs38" is BITS_6_10=22 { export vs38; }
xenonC: "vs39" is BITS_6_10=23 { export vs39; }
# vperm128: opaque; Xenia mask/value fc000210/14000000
:vperm128 xenonD,xenonA,xenonB,xenonC is OP=5 & xenonD & xenonA & xenonB & xenonC & BITS_4_5=0 & BIT_9=0
{
    result:16 = xenonVperm128(xenonA, xenonB, xenonC);
    xenonD = result;
}

:vperm128 xenonD,xenonA,xenonB,xenonC is OP=5 & xenonD & xenonA & xenonB & xenonC & BITS_4_5=2 & BIT_9=0
{
    result:16 = xenonVperm128(xenonA, xenonB, xenonC);
    xenonD = result;
}

# vaddfp128: native; Xenia mask/value fc0003d0/14000010
:vaddfp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=0 & BITS_4_5=1
{
    xenonInputALane0:4 = xenonA(0);
    xenonInputBLane0:4 = xenonB(0);
    xenonResultLane0:4 = xenonInputALane0 f+ xenonInputBLane0;
    xenonInputALane1:4 = xenonA(4);
    xenonInputBLane1:4 = xenonB(4);
    xenonResultLane1:4 = xenonInputALane1 f+ xenonInputBLane1;
    xenonInputALane2:4 = xenonA(8);
    xenonInputBLane2:4 = xenonB(8);
    xenonResultLane2:4 = xenonInputALane2 f+ xenonInputBLane2;
    xenonInputALane3:4 = xenonA(12);
    xenonInputBLane3:4 = xenonB(12);
    xenonResultLane3:4 = xenonInputALane3 f+ xenonInputBLane3;
    lane3:16 = zext(xenonResultLane3) << 96;
    lane2:16 = zext(xenonResultLane2) << 64;
    lane1:16 = zext(xenonResultLane1) << 32;
    lane0:16 = zext(xenonResultLane0);
    xenonD = lane3 | lane2 | lane1 | lane0;
}

