# Xenon supplemental VMX128 constructors; Xenia 95a5c3ee250f80c3b9d139658649d9ffb6db3eec.
# Native p-code when numerical operand semantics are sufficiently established.
# All other results are explicit opaque pcodeops; no false numerical behavior is invented.
# Some opaque families additionally affect CR6 or VSCR; their side effects remain incomplete.


define pcodeop xenonVmaddfp128;
define pcodeop xenonVmaddcfp128;
define pcodeop xenonVnmsubfp128;











# Updates sticky VSCR.SAT when any saturated pack lane exceeds range.
# VSCR itself still needs a register-backed model shared with mfvscr/mtvscr.
define pcodeop xenonSetVscrSatIf;
define pcodeop xenonVpkd3d128;
