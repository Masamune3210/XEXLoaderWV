# vsldoi128: native; Xenia mask/value fc000010/10000010
:vsldoi128 xenonD,xenonA,xenonB,BITS_6_10 is OP=4 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=1
{
    shift:4 = (BITS_6_10:4 & 15) * 8;
    back:4 = 128 - shift;
    xenonD = (xenonA << shift) | (xenonB >> back);
}

:vsldoi128 xenonD,xenonA,xenonB,BITS_6_10 is OP=4 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=3
{
    shift:4 = (BITS_6_10:4 & 15) * 8;
    back:4 = 128 - shift;
    xenonD = (xenonA << shift) | (xenonB >> back);
}

# Third source of vperm128 is a 3-bit VC selector (VR0..VR7).
# VX128_2 places VC in bits 6..8; bit 10 is VA's high bit.
# Bind actual register dependencies, not merely the encoded VC immediate.
xenonC: "vs32" is BITS_6_10=0 { export vs32; }
xenonC: "vs33" is BITS_6_10=1 { export vs33; }
xenonC: "vs34" is BITS_6_10=2 { export vs34; }
