xenonC: "vs39" is BITS_6_10=7 { export vs39; }
xenonC: "vs32" is BITS_6_10=16 { export vs32; }
xenonC: "vs33" is BITS_6_10=17 { export vs33; }
xenonC: "vs34" is BITS_6_10=18 { export vs34; }
xenonC: "vs35" is BITS_6_10=19 { export vs35; }
xenonC: "vs36" is BITS_6_10=20 { export vs36; }
xenonC: "vs37" is BITS_6_10=21 { export vs37; }
