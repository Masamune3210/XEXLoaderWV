# vsldoi128: native; Xenia mask/value fc000010/10000010
:vsldoi128 xenonD,xenonA,xenonB,BITS_6_10 is OP=4 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=1
{
    shift:4 = (BITS_6_10:4 & 15) * 8;
    back:4 = 128 - shift;
    xenonD = (xenonA << shift) | (xenonB >> back);
}

:vsldoi128 xenonD,xenonA,xenonB,BITS_6_10 is OP=4 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=3
{
    shift:4 = (BITS_6_10:4 & 15) * 8;
    back:4 = 128 - shift;
    xenonD = (xenonA << shift) | (xenonB >> back);
}

# vperm128: opaque; Xenia mask/value fc000210/14000000
:vperm128 xenonD,xenonA,xenonB,BITS_6_10 is OP=5 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=0 & BIT_9=0
{
    result:16 = xenonVperm128(xenonA, xenonB, BITS_6_10:4);
    xenonD = result;
}

:vperm128 xenonD,xenonA,xenonB,BITS_6_10 is OP=5 & xenonD & xenonA & xenonB & BITS_6_10 & BITS_4_5=2 & BIT_9=0
{
    result:16 = xenonVperm128(xenonA, xenonB, BITS_6_10:4);
    xenonD = result;
}

# vaddfp128: native; Xenia mask/value fc0003d0/14000010
:vaddfp128 xenonD,xenonA,xenonB is OP=5 & xenonD & xenonA & xenonB & BITS_6_10=0 & BITS_4_5=1
{
    a0:4 = xenonA(0);
    b0:4 = xenonB(0);
    r0:4 = a0 f+ b0;
    a1:4 = xenonA(4);
    b1:4 = xenonB(4);
    r1:4 = a1 f+ b1;
    a2:4 = xenonA(8);
    b2:4 = xenonB(8);
    r2:4 = a2 f+ b2;
    a3:4 = xenonA(12);
    b3:4 = xenonB(12);
    r3:4 = a3 f+ b3;
    xenonD = (zext(r3) << 96) | (zext(r2) << 64) | (zext(r1) << 32) | zext(r0);
}

