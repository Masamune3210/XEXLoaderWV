# Retail Xbox 360 Xenon PPC64, BE, 32-bit physical addressing.
# This is derived from Ghidra 12.1.3 PowerISA AltiVec, with independent
# register-accurate Xenon load/unpack patterns in xenon_vector_v1.sinc.
# For a reproducible compile, the -dPowerPC preprocessor option resolves
# installed stock Ghidra Processor PowerPC sources (see data/sleighArgs.txt).
@define ENDIAN "big"
@define IS_ISA "1"
@define NoLegacyIntegerMultiplyAccumulate "1"
@define REGISTER_SIZE "8"
@define BIT_64 "64"
@define EATRUNC "ea"
@define CTR_OFFSET "32"

# Generated from installed PPC common and embedded sources, omitting only
# the colliding embedded dcbzl alias. Stock PowerPC remains untouched.
@include "xenon_ppc_common.sinc"
# Variant-local restrictions for conflicting generic PPC/A2 encodings.
@include "xenon_ppc_isa.sinc"
@include "$(PowerPC)/data/languages/ppc_a2.sinc"
@include "$(PowerPC)/data/languages/quicciii.sinc"
@include "$(PowerPC)/data/languages/FPRC.sinc"
# Xenon VSCR is shared by inherited AltiVec mfvscr/mtvscr and VMX128.
# Hardware SAT is bit VSCR[31] (least-significant bit).
# Declare before its first use in the generated legacy AltiVec include.
define register offset=0x5000 size=4 [ xenonVSCR ];
# Xenon predates POWER ISA 2.07 / 3.0: avoid overlapping later opcodes.
# Gradle derives this variant-local copy from the installed Ghidra source.
@include "xenon_altivec_pre207.sinc"
@include "xenon_vector_v1.sinc"
# Supplementary VX128 instructions (native where verified; otherwise opaque).
@include "xenon_vector_remaining_v1.sinc"
